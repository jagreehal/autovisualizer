{
  "name": "autovisualizer",
  "version": "0.5.0",
  "description": "See and step through XState v6 and @xstate/effect machines in the browser.",
  "license": "Apache-2.0",
  "author": "Jag Reehal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/autovisualizer.git"
  },
  "homepage": "https://github.com/jagreehal/autovisualizer",
  "type": "module",
  "files": [
    "public/embed"
  ],
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "pnpm build:embed && vite build",
    "build:embed": "vite build -c vite.embed.config.ts",
    "prepublishOnly": "pnpm build:embed",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build:embed && changeset publish",
    "build:review": "vite build -c vite.review.config.ts",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt src e2e *.config.ts",
    "format:check": "oxfmt --check src e2e *.config.ts",
    "quality": "pnpm check-types && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:e2e",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@neon/auth": "0.8.2",
    "@neon/config": "1.13.0",
    "@neon/env": "2.1.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/router-plugin": "1.169.0",
    "@vercel/functions": "3.11.0",
    "@xstate/effect": "1.0.0-alpha.12",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "effect": "^4.1.2",
    "elkjs": "0.12.1",
    "jose": "6.2.16",
    "lucide-react": "1.70.0",
    "lz-string": "1.5.0",
    "mountly": "1.3.0",
    "mountly-react": "2.3.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.20.0",
    "sonner": "2.0.8",
    "sucrase": "3.35.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "xstate": "6.0.0-alpha.73"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@oxlint/plugins": "1.89.0",
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.2.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "mountly-vite-plugin": "1.7.0",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
