{
  "name": "autovisualizer",
  "version": "0.1.0",
  "private": true,
  "description": "See and step through XState v6 and @xstate/effect machines in the browser.",
  "license": "Apache-2.0",
  "author": "Jag Reehal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/autovisualizer.git"
  },
  "homepage": "https://github.com/jagreehal/autovisualizer",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt src e2e *.config.ts",
    "format:check": "oxfmt --check src e2e *.config.ts",
    "quality": "pnpm check-types && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/router-plugin": "1.169.0",
    "@xstate/effect": "1.0.0-alpha.12",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "effect": "^4.1.2",
    "elkjs": "0.12.1",
    "lucide-react": "1.70.0",
    "lz-string": "1.5.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.21.0",
    "sonner": "2.0.8",
    "sucrase": "3.35.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "xstate": "6.0.0-alpha.73"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
